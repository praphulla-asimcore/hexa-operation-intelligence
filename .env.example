# ── Database (Neon Postgres) ────────────────────────────────────────────────
# Use the POOLED connection string from Neon, with sslmode=require.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"

# ── NextAuth (Auth.js v5) ───────────────────────────────────────────────────
# Generate with:  openssl rand -hex 32
AUTH_SECRET="replace-with-64-char-hex-secret"
# Public base URL of the app (used for callbacks + invite links).
APP_URL="https://www.hexamatics.online"

# ── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
# Must be a verified sender/domain in Resend (falls back to Resend's sandbox).
EMAIL_FROM="Hexa Operation Intelligence <noreply@hexamatics.online>"

# ── Admin seed (used by `npm run seed`) ──────────────────────────────────────
# SEED_ADMIN_PASSWORD is REQUIRED to seed. Never commit a real password.
SEED_ADMIN_EMAIL="praphulla@hexamatics.com"
SEED_ADMIN_NAME="Praphulla Subedi"
SEED_ADMIN_PASSWORD="set-a-strong-password-here"
